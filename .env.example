# Copy to .env (git-ignored) and adjust. Never commit .env.
# All values here are placeholders.

# --- Database (the bundled PostgreSQL container) ---
POSTGRES_PASSWORD=change-me
# Used by the app/worker containers and the CLI. Point it at any PostgreSQL >= 14 if you
# prefer your own server.
DATABASE_URL=postgresql+psycopg://garminizer:change-me@localhost:55432/garminizer

# --- Web app ---
# 127.0.0.1 = this computer only (default). 0.0.0.0 = whole LAN (phone access); then
# APP_PASSWORD is required and the server refuses to start without it.
APP_HOST=127.0.0.1
APP_PORT=8420
APP_PASSWORD=
# Random string for signing session cookies (generated on first start if empty).
APP_SECRET_KEY=

# --- Garmin ---
# Preferred: connect in the app (Admin -> Connect Garmin); the password is not stored.
# Optional for unattended re-login when the saved tokens expire:
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKEN_DIR=./data/tokens

# --- Sync ---
SYNC_INTERVAL_HOURS=2
SYNC_REQUEST_DELAY_S=1.0
# Your local time zone (IANA name) for daily boundaries.
TZ=UTC
