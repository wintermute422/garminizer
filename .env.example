# Copy to .env (git-ignored) and adjust. Never commit .env. All values here are placeholders.

# --- Database (the bundled PostgreSQL 17 container) ---
POSTGRES_PASSWORD=change-me
# Host port of the database (for SQL clients / the CLI on this computer; bound to 127.0.0.1).
DB_PORT=55433
# Used by the CLI when you run `garminizer ...` on this computer (outside Docker). The containers
# build their own URL from POSTGRES_PASSWORD. Point it at any PostgreSQL >= 14 if you prefer.
DATABASE_URL=postgresql+psycopg://garminizer:change-me@127.0.0.1:55433/garminizer

# --- Web app ---
# 127.0.0.1 = this computer only (default). 0.0.0.0 = whole LAN (e.g. your phone); then
# APP_PASSWORD is required and the app refuses to start without it.
APP_HOST=127.0.0.1
APP_PORT=8420
APP_PASSWORD=
# Random string for signing session cookies (generated and stored on first start if empty).
APP_SECRET_KEY=

# --- Garmin ---
# Preferred: connect in the app (Sync & settings -> Connect Garmin); the password is not stored.
# Optional, only for unattended re-login when the saved tokens expire:
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- Sync & backups ---
SYNC_INTERVAL_HOURS=2
QUICK_SYNC_MINUTES=60
SYNC_REQUEST_DELAY_S=1.0
BACKUP_KEEP=14
# Your time zone (IANA name), used for daily boundaries and the 03:30 backup.
TZ=UTC
